# Run python scripts/init_instance.py to create a random password and key.
AIRDROP_ADMIN_USERNAME=admin
AIRDROP_ADMIN_PASSWORD=
AIRDROP_DATABASE_URL=sqlite:///data/airdrop.db
AIRDROP_MASTER_KEY_FILE=secrets/master.key
AIRDROP_GLOBAL_CONCURRENCY=2
AIRDROP_EXECUTION_ENABLED=false
AIRDROP_NATIVE_EXECUTION_ENABLED=false
AIRDROP_NATIVE_PYPI_INDEX_URL=https://pypi.org/simple
AIRDROP_NATIVE_SOCKET_GID=10001
AIRDROP_DOCKER_CLI_IMAGE=docker:27.5.1-cli
AIRDROP_SECURE_COOKIE=false
AIRDROP_API_PORT=18000
AIRDROP_WEB_PORT=18080
